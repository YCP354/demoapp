<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/btn_sim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lable_sim_test"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_photo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lable_photo_test"
        app:layout_constraintEnd_toStartOf="@id/btn_sim"
        app:layout_constraintTop_toBottomOf="@id/btn_sim" />

    <Button
        android:id="@+id/btn_printer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_lable_printer"
        app:layout_constraintEnd_toStartOf="@id/btn_sim"
        app:layout_constraintTop_toBottomOf="@id/btn_sim" />
    <Button
        android:id="@+id/btn_ble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="蓝牙测试"
        app:layout_constraintEnd_toStartOf="@id/btn_sim"
        app:layout_constraintTop_toBottomOf="@id/btn_sim" />
    <Button
        android:id="@+id/btn_sms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="短信测试"
        app:layout_constraintEnd_toStartOf="@id/btn_sim"
        app:layout_constraintTop_toBottomOf="@id/btn_sim" />
</LinearLayout>